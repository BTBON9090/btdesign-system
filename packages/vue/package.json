{
  "name": "@btdesign/vue",
  "version": "0.4.0",
  "description": "Vue 3 components for the BTDESIGN design system",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
