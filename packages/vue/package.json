  },
  "peerDependencies": {
    "vue": ">=3.4.0 <4"
  },
  "dependencies": {
    "@btdesign/tokens": "0.4.0",
    "@btdesign/engine": "0.4.0"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.0",
    "typescript": "^5.9.0",
    "vue": "^3.5.0"
  },
  "license": "MIT"
}
