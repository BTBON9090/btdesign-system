{
  "name": "@forma-ui/react",
  "version": "0.1.0",
  "description": "Accessible React components for Forma UI",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
