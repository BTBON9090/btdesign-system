# 服务端环境变量。复制为仓库根目录 .env；不要提交真实密钥。
# 留空时 AI 保持未配置状态，手动主题编辑和导出仍可用。
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash

# 独立的 Design Lab 访问令牌，不是 DeepSeek 密钥。
# 本地可选；NODE_ENV=production 或 VERCEL=1 时必填。
# 生成示例：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LAB_API_TOKEN=

# 本地 API 监听设置
API_HOST=127.0.0.1
API_PORT=8787

# 构建环境变量请在 shell 或部署平台设置，而不是依赖此服务端 .env：
# BASE_PATH=/design-system/
# VITE_API_BASE_URL=/design-system/api
# 所有 VITE_* 值都会进入浏览器构建；不要放入密钥或访问令牌。
